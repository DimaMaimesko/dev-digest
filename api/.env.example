# DevDigest API environment. scripts/dev.sh copies this file to api/.env and
# loads it for the Go commands; a variable already set in the shell wins.
DATABASE_URL=postgres://devdigest:devdigest@localhost:5433/devdigest

# LLM providers. Optional: the API starts with none. A key is only needed for
# the provider you run a review on. A key saved in the web app's Settings
# (~/.devdigest/secrets.json) wins over these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# GitHub personal access token with repo scope. GITHUB_PAT is read when
# GITHUB_TOKEN is empty.
GITHUB_TOKEN=

# repo-intel context (repo map + callers) in the review prompt. On unless
# set to false.
REPO_INTEL_ENABLED=true

API_PORT=3001
WEB_PORT=3000
# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=
# Where repositories are cloned; relative to api/, where dev.sh starts the API.
# Default: ~/.devdigest/workspace.
DEVDIGEST_CLONE_DIR=./clones
